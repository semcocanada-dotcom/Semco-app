# Copy to .env (gitignored) and fill in. Consumed by app.config.ts.
# In CI/EAS, set these as environment variables / EAS secrets instead.

# Supabase project (anon key is public + RLS-protected)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Cloud Vision API key (SENSITIVE — restrict by API + app, rotate if leaked)
GOOGLE_VISION_API_KEY=your-google-vision-key
