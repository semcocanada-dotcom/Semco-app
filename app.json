{
  "expo": {
    "name": "Semco Pro",
    "slug": "semco-pro",
    "version": "1.0.17",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "semco",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.semcocanada.semcopro",
      "googleServicesFile": "./config/firebase/GoogleService-Info.plist",
      "buildNumber": "18",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture color samples for custom formulas and project progress photos.",
        "NSPhotoLibraryUsageDescription": "Used to access project and color photos when you choose a saved image.",
        "NSPhotoLibraryAddUsageDescription": "Used to save project and color photos when you choose to keep them.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "versionCode": 18,
      "googleServicesFile": "./config/firebase/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.semcocanada.semcopro",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Semco Pro to access your camera to capture color samples and project progress photos.",
          "photosPermission": "Allow Semco Pro to access selected photos for project and color records.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cc9001d8-b1f9-44b2-b59c-c7b35d8c6129"
      }
    },
    "owner": "kitzul88"
  }
}
