{
  "expo": {
    "name": "Semco",
    "slug": "semco-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "semco",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8FF",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.semco.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF8FF"
      },
      "package": "ca.semco.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Semco to access your photos to attach receipts.",
          "cameraPermission": "Allow Semco to use your camera to capture receipts."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Semco to add appointments to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://wowlxyxaltgxbbsbcxao.supabase.co",
      "supabaseAnonKey": "sb_publishable_X9eDFGcf0Vn27-yct5E0dQ_4u-HgtN9",
      "googleVisionApiKey": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
